# Configuration GLPI — copier en .env et remplir les valeurs
# Toutes les variables exposées au client doivent être préfixées VITE_

# Base URL utilisée par le client (passe par le proxy Vite en dev)
VITE_API_BASE_URL=/api

# Cible du proxy Vite en dev (= url_base de GLPI)
VITE_API_PROXY_TARGET=https://localhost/glpi/public

# Client OAuth GLPI (Configuration > Générale > API > Clients OAuth)
VITE_OAUTH_CLIENT_ID=
VITE_OAUTH_CLIENT_SECRET=

# Scopes demandés au login
VITE_OAUTH_SCOPES=api user email
